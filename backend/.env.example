PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=stocksense
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5500

# Gmail SMTP for OTP emails.
# GMAIL_USER = the Gmail address sending the OTP (e.g. stocksense.hackathon@gmail.com)
# GMAIL_APP_PASSWORD = a 16-character App Password, NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
